{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": { "@/*": ["*"] }
  },
  "include": [
    "lib/i18n/config.ts",
    "lib/i18n/dictionaries.ts",
    "lib/i18n/localize.ts",
    "lib/i18n/progress-localization.ts",
    "lib/validation/login.ts",
    "lib/validation/gestion-users.ts",
    "lib/validation/grading.ts",
    "types/progress.ts",
    "tests/**/*.test.ts"
  ]
}
