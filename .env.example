# Copy to .env.local for local development. Never commit real secrets.

# --- Site ---
# Canonical origin used for metadata, sitemap.xml, robots.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://xclusiveacademy.com.au

# --- Supabase ---
# Safe to expose client-side (anon key is RLS-scoped).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI features ---
OPENAI_API_KEY=

# --- Analytics (all optional — features stay off until set) ---
# See docs/ANALYTICS_TRACKING_PLAN.md for what each one enables.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
